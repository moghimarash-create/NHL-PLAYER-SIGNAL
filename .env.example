NHL_PLAYER_INPUT_SHEET_ID=
NHL_PLAYER_CALC_SHEET_ID=

# Google Service Account JSON (only required if syncing to live NHL Google Sheets)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional frontend links to dedicated NHL Google Sheets
VITE_NHL_PLAYER_INPUT_SHEET_ID=
VITE_NHL_PLAYER_CALC_SHEET_ID=
